{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug report.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/report.py",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole"
    },
    {
      "name": "Debug tests",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["-v"],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole"
    }
  ]
}
