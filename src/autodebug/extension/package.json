{
  "name": "autodebug",
  "displayName": "AutoDebug",
  "description": "Lets an AI agent debug your program with this window's debugger, after you click Approve, and write a root-cause report.",
  "version": "0.5.0",
  "publisher": "autodebug",
  "license": "UNLICENSED",
  "engines": {"vscode": "^1.80.0"},
  "categories": ["Debuggers", "AI"],
  "extensionKind": ["workspace"],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "commands": [{"command": "autodebug.showLog", "title": "AutoDebug: Show Log"}],
    "mcpServerDefinitionProviders": [{"id": "autodebug.server", "label": "AutoDebug"}],
    "configuration": {
      "title": "AutoDebug",
      "properties": {
        "autodebug.bridgesFolder": {
          "type": "string",
          "default": "",
          "description": "Folder where this window announces itself to the AutoDebug server. Leave empty for the default."
        }
      }
    }
  }
}
